{
	"compilerOptions": {
		"lib": ["es2022"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"skipLibCheck": true,
		"strict": true,
		"target": "es2022",
		"types": ["@cloudflare/workers-types"],
		"verbatimModuleSyntax": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["dist", "node_modules"]
}

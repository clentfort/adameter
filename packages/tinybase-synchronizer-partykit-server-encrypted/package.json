{
	"name": "tinybase-synchronizer-partykit-server-encrypted",
	"version": "0.0.1",
	"description": "Encrypted PartyServer relay for TinyBase MergeableStore synchronization",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist",
		"README.md"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/clentfort/adameter.git",
		"directory": "packages/tinybase-synchronizer-partykit-server-encrypted"
	},
	"license": "MIT",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepack": "pnpm run build",
		"release": "semantic-release",
		"test": "vitest",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"peerDependencies": {
		"partyserver": ">=0.5.10"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "5.20261030.1",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/github": "12.0.10",
		"@semantic-release/npm": "13.2.0",
		"@semantic-release/release-notes-generator": "^14.0.3",
		"@types/node": "^26.0.0",
		"partyserver": "0.5.10",
		"semantic-release": "^25.0.0",
		"typescript": "^6.0.0",
		"vitest": "5.0.5"
	}
}

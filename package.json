{
	"name": "adameter",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@12.15.0",
	"scripts": {
		"predev": "pnpm run fbtee:collect && pnpm run fbtee:translate",
		"dev:next": "next dev",
		"dev:partyserver": "wrangler dev --port 1999",
		"dev": "concurrently \"pnpm:dev:*\"",
		"deploy:partyserver": "wrangler deploy --env=\"\"",
		"deploy:partyserver:preview": "wrangler deploy --env preview",
		"check:partyserver": "wrangler deploy --dry-run --env=\"\"",
		"prebuild": "pnpm run fbtee:collect && pnpm run fbtee:translate",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test": "vitest",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"pretypecheck": "pnpm run fbtee:collect && pnpm run fbtee:translate",
		"typecheck": "tsc --noEmit && tsc --noEmit -p party/tsconfig.json && pnpm --filter tinybase-synchronizer-partykit-server-encrypted typecheck",
		"fbtee:collect": "fbtee collect --common ./common_strings.json --src src",
		"fbtee:translate": "fbtee translate --translations translations/*.json --output-file src/i18n/translations.json --locale-style bcp47",
		"prepare": "husky"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"onFail": "warn",
			"version": "12.15.0"
		}
	},
	"dependencies": {
		"@base-ui/react": "1.9.0",
		"@hookform/resolvers": "6.0.1",
		"@nkzw/core": "^1.2.0",
		"@tailwindcss/postcss": "^4.1.4",
		"chart.js": "latest",
		"chartjs-adapter-date-fns": "latest",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "latest",
		"fast-deep-equal": "^3.1.3",
		"fbtee": "5.0.0",
		"file-saver": "^2.0.5",
		"friendly-words": "^1.3.1",
		"html5-qrcode": "^2.3.8",
		"jszip": "3.10.2",
		"leaflet": "^1.9.4",
		"lucide-react": "1.61.0",
		"nanoid": "6.0.2",
		"next": "16.4.3",
		"next-themes": "^0.4.6",
		"papaparse": "5.7.0",
		"partysocket": "1.3.0",
		"qrcode.react": "^4.2.0",
		"react": "19.3.1",
		"react-confetti": "^6.4.0",
		"react-dom": "19.3.1",
		"react-hook-form": "7.91.0",
		"react-markdown": "^10.1.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "3.7.0",
		"tailwindcss": "^4.1.4",
		"tinybase": "10.0.1",
		"tinybase-synchronizer-partykit-client-encrypted": "workspace:*",
		"tinybase-synchronizer-partykit-server-encrypted": "workspace:*",
		"tw-animate-css": "^1.2.8",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "5.20261027.1",
		"@eslint/eslintrc": "3.3.7",
		"@ianvs/prettier-plugin-sort-imports": "^4.4.1",
		"@next/eslint-plugin-next": "16.4.3",
		"@nkzw/eslint-config": "^3.3.0",
		"@nkzw/eslint-plugin-fbtee": "5.0.0",
		"@nkzw/fbtee-compiler": "5.0.0",
		"@nkzw/next-plugin-fbtee": "5.0.0",
		"@nkzw/vite-plugin-fbtee": "5.0.0",
		"@playwright/test": "1.64.1",
		"@tailwindcss/typography": "^0.5.19",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.8",
		"@types/file-saver": "^2.0.7",
		"@types/friendly-words": "^1.2.2",
		"@types/leaflet": "^1.9.22",
		"@types/node": "^24.0.0",
		"@types/papaparse": "^5.5.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react-swc": "^4.3.1",
		"@vitest/coverage-v8": "5.0.5",
		"concurrently": "10.0.6",
		"conventional-changelog-conventionalcommits": "9.3.1",
		"eslint": "10.13.0",
		"eslint-config-next": "16.4.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react-hooks": "^7.0.1",
		"husky": "^9.1.7",
		"jsdom": "^30.1.2",
		"lint-staged": "17.6.0",
		"partyserver": "0.5.10",
		"playwright": "1.64.1",
		"postcss": "8.5.32",
		"prettier": "3.9.10",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"tsx": "4.23.15",
		"typescript": "^6.0.0",
		"typescript-eslint": "8.72.1",
		"vite-tsconfig-paths": "^6.0.0",
		"vitest": "5.0.5",
		"wrangler": "4.153.0",
		"xlsx": "^0.18.5"
	}
}
